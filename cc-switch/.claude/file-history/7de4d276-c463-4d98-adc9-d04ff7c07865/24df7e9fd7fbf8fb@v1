[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "ctv-opd"
version = "0.1.0"
description = "Counterfactual teacher-value routing for budgeted on-policy distillation"
requires-python = ">=3.10"
dependencies = ["numpy>=1.24"]

[project.optional-dependencies]
test = ["pytest>=7"]
real = ["transformers>=4.45", "pandas>=2.0", "pyarrow>=14.0"]

[tool.setuptools]
package-dir = {"" = "src"}

[tool.setuptools.packages.find]
where = ["src"]
