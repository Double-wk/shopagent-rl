# secrets / runtime endpoints
.env
.env.*

# data & artifacts
# data/   ← 私有仓库全量备份，shop_A/data/（轨迹数据）一并上传
# outputs/ 不再整体忽略：experiment/outputs/ 下的 eval 结果（eval_*.jsonl /
#   *_tasks/ / *_official_metrics.json / *_full_report.json）需备份上传。
#   其中 SFT/GRPO 的 checkpoint 权重仍被下方 *.safetensors/*.bin/*.ckpt/*.log
#   及根 .gitignore 的 experiment/**/*.pt 排除。
checkpoints/
# Trainer-generated intermediate checkpoints are local resume state; only the
# final lora_adapter bundle for each experiment is archived in git.
outputs/sft/**/model/training_output/checkpoint-*/
# Hydra creates date-stamped launch metadata even for failed preflight runs.
outputs/20??-??-??/
# Keep completed training/evaluation logs when they provide experiment
# provenance. Exclude service noise, process state, failed superseded attempts,
# and incomplete evaluations; a completed formal log can still be added
# explicitly after the corresponding run finishes.
run/*.pid
run/pack_api.log
run/serve_*.log
run/merge_*.log
run/single_eval_*.log
run/certified_sft_b1_gc.log
run/certified_sft_b2_prefilter.log
run/*failed*.log
run/*interrupted*.log
run/certified_natural_grpo_*.log

# Full candidate pool used while constructing the frozen 800-row matched set.
data/grpo_certified_natural_pairblocked.parquet

# Superseded data snapshot that violates the current 10-turn protocol.
data/sft_train_certified_mix_pre10turn.jsonl

# python
__pycache__/
*.pyc
.ipynb_checkpoints/
archive/build/

# model weights
# 例外：*.safetensors.gz / .gz.partNN 是「复现必需权重」的压缩入库形式
#（SFT lora_adapter 与 GRPO artifacts/），由 scripts/restore_large_artifacts.sh 还原。
*.ckpt
*.safetensors
!*.safetensors.gz
!*.safetensors.gz.part*
*.bin

# Local FSDP resume state for the final env16 GRPO run.  These multi-GB files
# remain in outputs/ for resuming locally; the reproducible compressed adapter
# is kept under artifact/ instead.
outputs/grpo/v1/model/checkpoint_step_200/actor/*.pt
outputs/grpo/v1/model/checkpoint_step_200/data.pt
