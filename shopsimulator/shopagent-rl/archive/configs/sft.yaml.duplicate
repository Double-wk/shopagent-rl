# LoRA SFT config for the project's Qwen3-1.7B-Base model.
# Run:  python -m sft.train --config configs/sft.yaml   (shopsimulator env)
output_dir: /workspace/shopsimulator/shop_A/experiment/outputs/sft_new3793

data:
  train_file: /workspace/shopsimulator/shop_A/data/sft_train.jsonl

model:
  base_model: Qwen/Qwen3-1.7B-Base
  lora_r: 32
  lora_alpha: 64
  lora_dropout: 0.05
  # Qwen3 (LLAMA-arch) attention + MLP projections
  lora_target_modules: [q_proj, k_proj, v_proj, o_proj, gate_proj, up_proj, down_proj]

train:
  max_seq_length: 8192        # 8K context per project spec
  batch_size: 1
  grad_accum: 8               # effective batch 8
  epochs: 3
  lr: 1.0e-4                  # LoRA typical
  warmup_ratio: 0.03
  logging_steps: 10
  save_strategy: epoch
